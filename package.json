{
  "name": "tales",
  "version": "0.11.3",
  "description": "synyx presentation style for everyone",
  "author": "synyx",
  "main": "dist/main.js",
  "browser": "public/js/tales.js",
  "postinstall": "electron-builder install-app-deps",
  "scripts": {
    "start": "electron .",
    "build": "rollup -c && npm run build:css",
    "build:css": "postcss src/css/*.css --dir pkg/web/public/css/",
    "dist": "electron-builder --publish=never",
    "format": "prettier --write 'src/js/**/*.js' 'src/css/**/*.css'",
    "lint": "eslint src/js",
    "pack": "electron-builder --dir",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm test && npm run lint",
    "test": "jest",
    "watch": "rollup -c -w",
    "watch:css": "postcss src/css/*.css --dir pkg/web/public/css/ -w"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:synyx/tales.git"
  },
  "keywords": [
    "poster",
    "presentation",
    "presentation-tools",
    "svg"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/synyx/tales/issues"
  },
  "homepage": "https://github.com/synyx/tales#readme",
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@rollup/plugin-babel": "7.0.0",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "cssnano": "7.1.3",
    "electron": "40.8.0",
    "electron-builder": "26.8.1",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.0",
    "eslint-plugin-prettier": "5.5.5",
    "flyps": "0.6.7",
    "flyps-dom-snabbdom": "0.3.1",
    "gl-matrix": "3.4.4",
    "globals": "17.4.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "node-polyglot": "2.6.0",
    "postcss-cli": "11.0.1",
    "postcss-import": "16.1.1",
    "prettier": "3.8.1",
    "rollup": "4.59.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.test.js"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "roots": [
      "<rootDir>/src/js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testEnvironment": "jsdom"
  }
}
